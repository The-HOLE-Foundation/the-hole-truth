# Copy to .env.local for local dev. Never commit a real .env.local.

# --- LLM provider ---
# Required when the request-drafting pipeline lands. Not used by the v0 landing page.
ANTHROPIC_API_KEY=

# --- Database ---
# Postgres connection string. Use a Neon dev branch URL for local development.
# Required when the statute pipeline lands (THE-4). Not used by the v0 landing page.
DATABASE_URL=

# --- Runtime ---
# Public site URL. Used for canonical links, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
